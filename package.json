{
  "name": "yargs-unparser",
  "description": "Converts back a yargs argv object to its original array form",
  "version": "2.0.0",
  "keywords": [
    "yargs",
    "unparse",
    "expand",
    "inverse",
    "argv"
  ],
  "author": "André Cruz <andre@moxy.studio>",
  "engines": {
    "node": ">=10"
  },
  "homepage": "https://github.com/yargs/yargs-unparser",
  "repository": "yargs/yargs-unparser",
  "license": "MIT",
  "main": "index.js",
  "files": [],
  "scripts": {
    "check": "npm run check:lint && npm run check:format",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "fix": "npm run fix:lint && npm run fix:format",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "posttest": "npm run check",
    "prerelease": "npm t",
    "test": "jest --env node --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "jest": "^24.9.0",
    "prettier": "^3.10.1",
    "yargs": "^17.7.3",
    "yargs-parser": "^18.1.3"
  },
  "dependencies": {
    "camelcase": "^6.0.0",
    "decamelize": "^4.0.0",
    "flat": "^5.0.2",
    "is-plain-obj": "^2.1.0"
  }
